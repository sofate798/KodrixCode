{
  "name": "minicode-agent-os",
  "displayName": "Minicode Agent OS",
  "description": "让软件开发回归想法本身 — Idea Flow 全自动流水线 · Repo Wiki · Spec 驱动 · Memory · Kanban · Agent 路由 · Arena · Hooks · ACP · 属性测试 · 越用越聪明",
  "version": "1.0.0",
  "publisher": "minicode",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Machine Learning"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension",
  "enabledApiProposals": [
    "chatContextProvider"
  ],
  "contributes": {
    "chatParticipants": [
      {
        "id": "minicode.codebase",
        "name": "codebase",
        "fullName": "Codebase Intelligence",
        "description": "自然语言代码问答：查询符号定义 / 引用 / 依赖 / 架构（本地语义索引，零外部依赖）",
        "isSticky": true,
        "commands": [
          {
            "name": "def",
            "description": "查找符号定义位置"
          },
          {
            "name": "refs",
            "description": "查找符号的所有引用"
          },
          {
            "name": "deps",
            "description": "查看文件的依赖关系"
          },
          {
            "name": "dependents",
            "description": "查看哪些文件依赖该文件"
          }
        ]
      }
    ],
    "localizations": [
      {
        "languageId": "zh-cn",
        "languageName": "Chinese (Simplified)",
        "localizedLanguageName": "简体中文",
        "translations": [
          {
            "id": "minicode.minicode-agent-os",
            "path": "package.nls.zh-cn.json"
          }
        ]
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "minicode.agentKanban",
          "name": "Agent 看板",
          "when": "config.minicode.features.kanban"
        }
      ]
    },
    "commands": [
      {
        "command": "minicode.wiki.generate",
        "title": "生成 Repo Wiki",
        "category": "Minicode"
      },
      {
        "command": "minicode.wiki.open",
        "title": "打开 Repo Wiki",
        "category": "Minicode"
      },
      {
        "command": "minicode.spec.create",
        "title": "新建 Spec（需求→设计→任务）",
        "category": "Minicode"
      },
      {
        "command": "minicode.spec.open",
        "title": "打开 Spec",
        "category": "Minicode"
      },
      {
        "command": "minicode.spec.openWorkbench",
        "title": "打开 Spec 三栏工作台（Kiro）",
        "category": "Minicode"
      },
      {
        "command": "minicode.spec.implement",
        "title": "实施 Spec 任务（Agent 模式）",
        "category": "Minicode"
      },
      {
        "command": "minicode.memory.show",
        "title": "查看项目 Memory",
        "category": "Minicode"
      },
      {
        "command": "minicode.memory.capture",
        "title": "从对话捕获 Memory",
        "category": "Minicode"
      },
      {
        "command": "minicode.kanban.addTask",
        "title": "添加 Agent 任务",
        "category": "Minicode"
      },
      {
        "command": "minicode.kanban.moveTask",
        "title": "移动任务状态",
        "category": "Minicode"
      },
      {
        "command": "minicode.kanban.openSession",
        "title": "打开关联 Agent 会话",
        "category": "Minicode"
      },
      {
        "command": "minicode.kanban.deleteTask",
        "title": "删除任务",
        "category": "Minicode"
      },
      {
        "command": "minicode.kanban.refresh",
        "title": "刷新看板",
        "category": "Minicode"
      },
      {
        "command": "minicode.kanban.focus",
        "title": "聚焦 Agent 看板",
        "category": "Minicode"
      },
      {
        "command": "minicode.router.route",
        "title": "智能路由（自动选 SOLO/Spec/Plan/Agent/Ask）",
        "category": "Minicode"
      },
      {
        "command": "minicode.arena.compare",
        "title": "Arena 双模型对比",
        "category": "Minicode"
      },
      {
        "command": "minicode.hooks.installPresets",
        "title": "安装 Hooks 预置包",
        "category": "Minicode"
      },
      {
        "command": "minicode.acp.register",
        "title": "注册 ACP 外部 Agent",
        "category": "Minicode"
      },
      {
        "command": "minicode.acp.list",
        "title": "列出 ACP 外部 Agent",
        "category": "Minicode"
      },
      {
        "command": "minicode.testing.generatePropertyTests",
        "title": "生成属性测试（Spec / Kiro 风格）",
        "category": "Minicode"
      },
      {
        "command": "minicode.agentOs.welcome",
        "title": "Agent OS 功能概览",
        "category": "Minicode"
      },
      {
        "command": "minicode.learn.capture",
        "title": "沉淀项目知识（越用越聪明）",
        "category": "Minicode"
      },
      {
        "command": "minicode.learn.dashboard",
        "title": "Learning 学习仪表盘",
        "category": "Minicode"
      },
      {
        "command": "minicode.context.status",
        "title": "查看上下文状态",
        "category": "Minicode"
      },
      {
        "command": "minicode.context.refresh",
        "title": "刷新 Agent 上下文",
        "category": "Minicode"
      },
      {
        "command": "minicode.learn.installSessionHook",
        "title": "安装 Session Learning Hook（Agent 结束自动学习）",
        "category": "Minicode"
      },
      {
        "command": "minicode.learn.sessionStatus",
        "title": "Session Learning 状态",
        "category": "Minicode"
      },
      {
        "command": "minicode.learn.processPendingSessions",
        "title": "处理待学习会话队列",
        "category": "Minicode"
      },
      {
        "command": "minicode.hub.open",
        "title": "打开 Minicode Hub（Agent 指挥中心）",
        "category": "Minicode"
      },
      {
        "command": "minicode.router.repeatLast",
        "title": "重复上次智能路由",
        "category": "Minicode"
      },
      {
        "command": "minicode.crew.create",
        "title": "创建 Agent Crew（多智能体编排）",
        "category": "Minicode"
      },
      {
        "command": "minicode.crew.addTask",
        "title": "添加 Crew 任务",
        "category": "Minicode"
      },
      {
        "command": "minicode.crew.runNext",
        "title": "执行下一个 Crew 任务",
        "category": "Minicode"
      },
      {
        "command": "minicode.crew.markDone",
        "title": "标记 Crew 任务完成",
        "category": "Minicode"
      },
      {
        "command": "minicode.crew.status",
        "title": "查看 Crew 状态",
        "category": "Minicode"
      },
      {
        "command": "minicode.vibe.start",
        "title": "Vibe Coding — 一句话生成项目",
        "category": "Minicode"
      },
      {
        "command": "minicode.vibe.quick",
        "title": "快速 Vibe（预设模板选择）",
        "category": "Minicode"
      },
      {
        "command": "minicode.idea.open",
        "title": "打开 Idea Canvas（想法→产品）",
        "category": "Minicode"
      },
      {
        "command": "minicode.idea.start",
        "title": "Idea Flow — 输入想法自动构建",
        "category": "Minicode"
      },
      {
        "command": "minicode.idea.status",
        "title": "查看 Idea Flow 状态",
        "category": "Minicode"
      },
      {
        "command": "minicode.idea.restart",
        "title": "重置 Idea Flow",
        "category": "Minicode"
      },
      {
        "command": "minicode.codebase.search",
        "title": "代码库问答（自然语言搜索代码定义/引用/架构）",
        "category": "Minicode"
      },
      {
        "command": "minicode.codebase.buildIndex",
        "title": "重建全工程语义索引",
        "category": "Minicode"
      },
      {
        "command": "minicode.codebase.stats",
        "title": "查看项目索引统计",
        "category": "Minicode"
      }
    ],
    "keybindings": [
      {
        "command": "minicode.hub.open",
        "key": "ctrl+shift+h",
        "mac": "cmd+shift+h",
        "when": "config.minicode.hub.enableKeybinding"
      },
      {
        "command": "minicode.spec.openWorkbench",
        "key": "ctrl+shift+alt+k",
        "when": "config.minicode.features.spec"
      },
      {
        "command": "minicode.router.route",
        "key": "ctrl+shift+alt+r",
        "when": "config.minicode.features.agentRouter"
      },
      {
        "command": "minicode.learn.capture",
        "key": "ctrl+shift+alt+m",
        "when": "config.minicode.features.learning"
      },
      {
        "command": "minicode.vibe.start",
        "key": "ctrl+shift+v",
        "when": "config.minicode.features.vibeCoding"
      },
      {
        "command": "minicode.idea.start",
        "key": "ctrl+shift+i",
        "mac": "cmd+shift+i",
        "when": "config.minicode.features.ideaFlow"
      },
      {
        "command": "minicode.idea.open",
        "key": "ctrl+shift+alt+i",
        "mac": "cmd+shift+alt+i",
        "when": "config.minicode.features.ideaFlow"
      },
      {
        "command": "minicode.codebase.search",
        "key": "ctrl+shift+alt+f",
        "when": "config.minicode.features.codebaseIntelligence"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "minicode.kanban.addTask",
          "when": "view == minicode.agentKanban",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "minicode.kanban.moveTask",
          "when": "view == minicode.agentKanban",
          "group": "inline"
        },
        {
          "command": "minicode.kanban.openSession",
          "when": "view == minicode.agentKanban",
          "group": "inline"
        },
        {
          "command": "minicode.kanban.deleteTask",
          "when": "view == minicode.agentKanban",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "Minicode Agent OS",
      "properties": {
        "minicode.features.wiki": {
          "type": "boolean",
          "default": true,
          "description": "启用 Repo Wiki 自动生成（Qoder 风格）"
        },
        "minicode.features.wikiAutoBuild": {
          "type": "boolean",
          "default": true,
          "description": "打开工作区时自动生成 Repo Wiki"
        },
        "minicode.features.spec": {
          "type": "boolean",
          "default": true,
          "description": "启用 Spec 驱动工作流（Kiro 风格）"
        },
        "minicode.features.memory": {
          "type": "boolean",
          "default": true,
          "description": "启用跨会话 Memory（Windsurf 风格）"
        },
        "minicode.features.kanban": {
          "type": "boolean",
          "default": true,
          "description": "启用 Agent Kanban 看板（Devin/Qoder Quest 风格）"
        },
        "minicode.features.agentRouter": {
          "type": "boolean",
          "default": true,
          "description": "启用统一 Agent OS 智能路由"
        },
        "minicode.features.arena": {
          "type": "boolean",
          "default": true,
          "description": "启用 Arena 双模型对比（Windsurf 风格）"
        },
        "minicode.features.hooks": {
          "type": "boolean",
          "default": true,
          "description": "启用 Hooks 预置包（Kiro 风格）"
        },
        "minicode.features.acp": {
          "type": "boolean",
          "default": true,
          "description": "启用 ACP 外部 Agent 接入（Devin Desktop 风格）"
        },
        "minicode.features.propertyTests": {
          "type": "boolean",
          "default": true,
          "description": "启用属性测试生成（Kiro 风格）"
        },
        "minicode.features.learning": {
          "type": "boolean",
          "default": true,
          "description": "启用 Learning Engine（越用越聪明 — 跨会话知识沉淀）"
        },
        "minicode.features.contextInjection": {
          "type": "boolean",
          "default": true,
          "description": "自动将 Wiki + Memory + Learning 注入 Agent Instructions 与 Chat 上下文"
        },
        "minicode.features.sessionLearning": {
          "type": "boolean",
          "default": true,
          "description": "Agent 会话结束时自动蒸馏项目知识（Stop Hook + LLM）"
        },
        "minicode.sessionLearning.mode": {
          "type": "string",
          "enum": [
            "auto",
            "prompt",
            "off"
          ],
          "default": "prompt",
          "description": "会话学习模式：auto 自动沉淀 / prompt 询问确认 / off 关闭"
        },
        "minicode.sessionLearning.minUserMessages": {
          "type": "number",
          "default": 1,
          "minimum": 1,
          "description": "至少多少条用户消息才触发会话学习（过滤 trivial 会话）"
        },
        "minicode.sessionLearning.autoInstallHook": {
          "type": "boolean",
          "default": true,
          "description": "首次打开工作区时自动安装 .github/hooks Session Learning Hook"
        },
        "minicode.arena.modelA": {
          "type": "string",
          "default": "",
          "description": "Arena 对比模型 A（留空则使用当前默认模型）"
        },
        "minicode.arena.modelB": {
          "type": "string",
          "default": "",
          "description": "Arena 对比模型 B"
        },
        "minicode.router.lastRoute": {
          "type": "object",
          "default": {},
          "description": "上次智能路由结果（自动记录）"
        },
        "minicode.kanban.showCompleted": {
          "type": "boolean",
          "default": true,
          "description": "在看板中显示已完成的任务"
        },
        "minicode.experience.autoBootstrap": {
          "type": "boolean",
          "default": true,
          "description": "打开工作区时自动预热 Agent 上下文（Wiki · Memory · Learning · Hooks）"
        },
        "minicode.experience.showBootstrapTip": {
          "type": "boolean",
          "default": true,
          "description": "首次打开工作区时显示 Hub / 智能路由引导提示"
        },
        "minicode.features.contextIntelligence": {
          "type": "boolean",
          "default": true,
          "description": "启用 Context Intelligence（Wiki + Memory + Learning 自动注入 Chat）"
        },
        "minicode.features.semanticMemory": {
          "type": "boolean",
          "default": true,
          "description": "启用语义记忆索引（TF-IDF 向量检索，零外部依赖）"
        },
        "minicode.features.proactiveContext": {
          "type": "boolean",
          "default": true,
          "description": "打开文件时主动提示相关 Learning / Memory（状态栏 💡 指示）"
        },
        "minicode.router.autoExecute": {
          "type": "boolean",
          "default": true,
          "description": "智能路由高置信度时自动执行（无需二次确认）"
        },
        "minicode.features.agentCrew": {
          "type": "boolean",
          "default": true,
          "description": "启用 Agent Crew 多智能体协作编排（Devin / Cursor 3.0 风格）"
        },
        "minicode.features.vibeCoding": {
          "type": "boolean",
          "default": true,
          "description": "启用 Vibe Coding（一句描述自动构建项目）"
        },
        "minicode.features.ideaFlow": {
          "type": "boolean",
          "default": true,
          "description": "启用 Idea Flow — 想法到产品的全自动流水线。从模糊想法到完整可运行应用，AI 负责分析→规划→构建→预览全部环节"
        },
        "minicode.hub.enableKeybinding": {
          "type": "boolean",
          "default": true,
          "description": "启用 Ctrl+Shift+H 打开 Minicode Hub（关闭后恢复 VS Code 全局替换快捷键）"
        },
        "minicode.features.codebaseIntelligence": {
          "type": "boolean",
          "default": true,
          "description": "启用 Codebase Intelligence — 全工程语义索引（AST 级符号/依赖/调用图分析）"
        },
        "minicode.features.predictiveCompletion": {
          "type": "boolean",
          "default": true,
          "description": "启用上下文预测补全 — 基于全工程索引的「下一步编辑」预测"
        },
        "minicode.features.codebaseQuery": {
          "type": "boolean",
          "default": true,
          "description": "启用自然语言代码问答 — @codebase 查询定义/引用/架构"
        }
      }
    }
  },
  "scripts": {
    "compile": "gulp compile-extension:minicode-agent-os",
    "watch": "gulp watch-extension:minicode-agent-os"
  },
  "devDependencies": {
    "@types/node": "24.x"
  },
  "dependencies": {
    "@parcel/watcher": "^2.5.6"
  }
}
