{
  "name": "kodrix-local",
  "displayName": "Kodrix Local Models",
  "description": "%description%",
  "version": "1.0.0",
  "publisher": "kodrix",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Machine Learning"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onSettingsEditorRenderer:kodrix.providerSettings"
  ],
  "enabledApiProposals": [
    "settingsEditorRenderer"
  ],
  "main": "./out/extension",
  "contributes": {
    "settingsEditorRenderers": [
      {
        "viewType": "kodrix.providerSettings"
      }
    ],
    "localizations": [
      {
        "languageId": "zh-cn",
        "languageName": "Chinese (Simplified)",
        "localizedLanguageName": "简体中文",
        "translations": [
          {
            "id": "kodrix.kodrix-local",
            "path": "package.nls.zh-cn.json"
          }
        ]
      }
    ],
    "languageModelChatProviders": [
      {
        "vendor": "kodrix",
        "displayName": "Kodrix"
      }
    ],
    "commands": [
      {
        "command": "kodrix.migrateConfig",
        "title": "%command.migrateConfig.title%",
        "category": "Kodrix"
      },
      {
        "command": "kodrix.openProviderPresets",
        "title": "%command.openProviderPresets.title%",
        "category": "Kodrix"
      },
      {
        "command": "kodrix.openProviderWorkbench",
        "title": "%command.openProviderWorkbench.title%",
        "category": "Kodrix"
      },
      {
        "command": "kodrix.applyPreset",
        "title": "%command.applyPreset.title%",
        "category": "Kodrix"
      },
      {
        "command": "kodrix.welcome",
        "title": "%command.welcome.title%",
        "category": "Kodrix"
      },
      {
        "command": "kodrix.importCursor",
        "title": "%command.importCursor.title%",
        "category": "Kodrix"
      },
      {
        "command": "kodrix.addSelectionToChat",
        "title": "%command.addSelectionToChat.title%",
        "category": "Kodrix"
      },
      {
        "command": "kodrix.openInlineEdit",
        "title": "%command.openInlineEdit.title%",
        "category": "Kodrix"
      },
      {
        "command": "kodrix.openPlanMode",
        "title": "%command.openPlanMode.title%",
        "category": "Kodrix"
      },
      {
        "command": "kodrix.openComposer",
        "title": "%command.openComposer.title%",
        "category": "Kodrix"
      },
      {
        "command": "kodrix.attachCodebase",
        "title": "%command.attachCodebase.title%",
        "category": "Kodrix"
      },
      {
        "command": "kodrix.buildCodebaseIndex",
        "title": "%command.buildCodebaseIndex.title%",
        "category": "Kodrix"
      },
      {
        "command": "kodrix.continueInBackground",
        "title": "%command.continueInBackground.title%",
        "category": "Kodrix"
      },
      {
        "command": "kodrix.continueInCloud",
        "title": "%command.continueInCloud.title%",
        "category": "Kodrix"
      },
      {
        "command": "kodrix.applyCursorFeatures",
        "title": "%command.applyCursorFeatures.title%",
        "category": "Kodrix"
      },
      {
        "command": "kodrix.applyCursor3Experience",
        "title": "%command.applyCursor3Experience.title%",
        "category": "Kodrix"
      },
      {
        "command": "kodrix.openAgentsWindow",
        "title": "%command.openAgentsWindow.title%",
        "category": "Kodrix"
      },
      {
        "command": "kodrix.openWorkspaceInAgentsWindow",
        "title": "%command.openWorkspaceInAgentsWindow.title%",
        "category": "Kodrix"
      },
      {
        "command": "kodrix.onboarding.open",
        "title": "%command.onboardingOpen.title%",
        "category": "Kodrix"
      }
    ],
    "configuration": {
      "title": "Kodrix",
      "properties": {
        "kodrix.migrateOnFirstRun": {
          "type": "boolean",
          "default": true,
          "description": "%config.migrateOnFirstRun.description%"
        },
        "kodrix.importCursorOnFirstRun": {
          "type": "boolean",
          "default": true,
          "description": "%config.importCursorOnFirstRun.description%"
        },
		"kodrix.modelRoutes": {
          "type": "object",
          "default": {},
          "description": "%config.modelRoutes.description%",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "model": {
                "type": "string",
                "description": "%config.modelRoutes.model.description%"
              }
            }
          }
        },
        "github.copilot.chat.implementAgent.model": {
          "type": "string",
          "default": "",
          "description": "%config.implementAgentModel.description%"
        },
        "kodrix.features.tabCompletion": {
          "type": "boolean",
          "default": true,
          "description": "%config.tabCompletion.description%"
        },
        "kodrix.features.backgroundAgents": {
          "type": "boolean",
          "default": true,
          "description": "%config.backgroundAgents.description%"
        },
        "kodrix.features.cloudAgents": {
          "type": "boolean",
          "default": true,
          "description": "%config.cloudAgents.description%"
        },
        "kodrix.features.composerUI": {
          "type": "boolean",
          "default": true,
          "description": "%config.composerUI.description%"
        },
        "kodrix.features.codebaseIndex": {
          "type": "boolean",
          "default": true,
          "description": "%config.codebaseIndex.description%"
        },
        "kodrix.features.codebaseIndexAutoBuild": {
          "type": "boolean",
          "default": true,
          "description": "%config.codebaseIndexAutoBuild.description%"
        },
        "kodrix.features.agentsWindow": {
          "type": "boolean",
          "default": true,
          "description": "%config.agentsWindow.description%"
        },
        "kodrix.features.agentFirstLayout": {
          "type": "boolean",
          "default": true,
          "description": "%config.agentFirstLayout.description%"
        },
        "kodrix.features.agentHostPriority": {
          "type": "boolean",
          "default": true,
          "description": "%config.agentHostPriority.description%"
        },
        "kodrix.features.handoffTip": {
          "type": "boolean",
          "default": true,
          "description": "%config.handoffTip.description%"
        },
        "kodrix.providerWorkbench.panel": {
          "type": "null",
          "default": null,
          "renderer": "kodrix.providerSettings",
          "markdownDescription": "%config.providerWorkbenchPanel.markdownDescription%"
        }
      }
    },
    "keybindings": [
      {
        "command": "workbench.action.chat.open",
        "key": "ctrl+l",
        "mac": "cmd+l",
        "when": "!terminalFocus"
      },
      {
        "command": "workbench.action.chat.open",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "args": { "mode": "agent" },
        "when": "config.chat.agent.enabled && !terminalFocus"
      },
      {
        "command": "kodrix.openInlineEdit",
        "key": "ctrl+k",
        "mac": "cmd+k",
        "when": "editorTextFocus && !editorReadonly"
      },
      {
        "command": "kodrix.addSelectionToChat",
        "key": "ctrl+shift+l",
        "mac": "cmd+shift+l",
        "when": "editorTextFocus && editorHasSelection"
      },
      {
        "command": "kodrix.openWorkspaceInAgentsWindow",
        "key": "ctrl+shift+alt+a",
        "mac": "cmd+shift+alt+a",
        "when": "config.chat.agent.enabled && !isSessionsWindow && workspaceFolderCount > 0"
      },
      {
        "command": "kodrix.openAgentsWindow",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a",
        "when": "config.chat.agent.enabled && !isSessionsWindow"
      }
    ]
  },
  "scripts": {
    "compile": "gulp compile-extension:kodrix-local",
    "watch": "gulp watch-extension:kodrix-local",
    "compile:test": "tsc -p tsconfig.test.json",
    "test": "npm run compile:test && node ./out-test/test/runTests.js"
  },
  "devDependencies": {
    "@types/node": "24.x"
  }
}
