{
  "name": "kodrix-local",
  "displayName": "Kodrix Local Models",
  "description": "本地大模型与云端 API 供应商配置，Cursor 风格快捷键与一键导入",
  "version": "1.0.0",
  "publisher": "kodrix",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Machine Learning"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onSettingsEditorRenderer:kodrix.providerSettings"
  ],
  "enabledApiProposals": [
    "settingsEditorRenderer"
  ],
  "main": "./out/extension",
  "contributes": {
    "settingsEditorRenderers": [
      {
        "viewType": "kodrix.providerSettings"
      }
    ],
    "localizations": [
      {
        "languageId": "zh-cn",
        "languageName": "Chinese (Simplified)",
        "localizedLanguageName": "简体中文",
        "translations": [
          {
            "id": "kodrix.kodrix-local",
            "path": "package.nls.zh-cn.json"
          }
        ]
      }
    ],
    "languageModelChatProviders": [
      {
        "vendor": "kodrix",
        "displayName": "Kodrix"
      }
    ],
    "commands": [
      {
        "command": "kodrix.migrateConfig",
        "title": "迁移配置（Cursormini / Kodrix）",
        "category": "Kodrix"
      },
      {
        "command": "kodrix.openProviderPresets",
        "title": "浏览模型供应商预设",
        "category": "Kodrix"
      },
      {
        "command": "kodrix.openProviderWorkbench",
        "title": "AI 供应商管理",
        "category": "Kodrix"
      },
      {
        "command": "kodrix.applyPreset",
        "title": "应用模型预设",
        "category": "Kodrix"
      },
      {
        "command": "kodrix.welcome",
        "title": "欢迎使用 Kodrix",
        "category": "Kodrix"
      },
      {
        "command": "kodrix.importCursor",
        "title": "从 Cursor 导入（Rules / MCP / Skills）",
        "category": "Kodrix"
      },
      {
        "command": "kodrix.addSelectionToChat",
        "title": "将选区添加到聊天",
        "category": "Kodrix"
      },
      {
        "command": "kodrix.openInlineEdit",
        "title": "行内编辑（Cursor Ctrl+K）",
        "category": "Kodrix"
      },
      {
        "command": "kodrix.openPlanMode",
        "title": "打开 Plan 模式",
        "category": "Kodrix"
      },
      {
        "command": "kodrix.openComposer",
        "title": "打开 Composer（多文件 Agent）",
        "category": "Kodrix"
      },
      {
        "command": "kodrix.attachCodebase",
        "title": "添加 @Codebase 上下文",
        "category": "Kodrix"
      },
      {
        "command": "kodrix.buildCodebaseIndex",
        "title": "构建代码库语义索引",
        "category": "Kodrix"
      },
      {
        "command": "kodrix.continueInBackground",
        "title": "在 Background Agent 中继续",
        "category": "Kodrix"
      },
      {
        "command": "kodrix.continueInCloud",
        "title": "在 Cloud Agent 中继续",
        "category": "Kodrix"
      },
      {
        "command": "kodrix.applyCursorFeatures",
        "title": "应用 Cursor 对标功能默认配置",
        "category": "Kodrix"
      },
      {
        "command": "kodrix.applyCursor3Experience",
        "title": "应用 Cursor 3.0 Agent 中心体验",
        "category": "Kodrix"
      },
      {
        "command": "kodrix.openAgentsWindow",
        "title": "打开 Agents 窗口",
        "category": "Kodrix"
      },
      {
        "command": "kodrix.openWorkspaceInAgentsWindow",
        "title": "在 Agents 窗口中打开当前工作区",
        "category": "Kodrix"
      },
      {
        "command": "kodrix.onboarding.open",
        "title": "打开欢迎向导",
        "category": "Kodrix"
      }
    ],
    "configuration": {
      "title": "Kodrix",
      "properties": {
        "kodrix.migrateOnFirstRun": {
          "type": "boolean",
          "default": true,
          "description": "首次启动时自动迁移 ~/.cursormini 或 ~/.kodrix 中的模型与 Agent 配置"
        },
        "kodrix.importCursorOnFirstRun": {
          "type": "boolean",
          "default": true,
          "description": "首次启动时自动从 Cursor 导入 Rules、MCP 与 Skills（若存在 ~/.cursor）"
        },
		"kodrix.modelRoutes": {
          "type": "object",
          "default": {},
          "description": "多模型路由（plan / agent / code / fast），每项仅使用 model 字段",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "model": {
                "type": "string",
                "description": "模型 ID（须已在 Manage Models 中可用）"
              }
            }
          }
        },
        "github.copilot.chat.implementAgent.model": {
          "type": "string",
          "default": "",
          "description": "Plan 交接后的 Implement Agent 所用模型（Copilot 未贡献该键时由 Kodrix 兜底注册，便于写入用户设置）"
        },
        "kodrix.features.tabCompletion": {
          "type": "boolean",
          "default": true,
          "description": "启用 Cursor Tab 级体验：Copilot 补全 + Next Edit Suggestions (NES)"
        },
        "kodrix.features.backgroundAgents": {
          "type": "boolean",
          "default": true,
          "description": "启用 Background Agent（Copilot CLI 后台任务）"
        },
        "kodrix.features.cloudAgents": {
          "type": "boolean",
          "default": true,
          "description": "启用 Cloud Agent（Copilot Coding Agent）"
        },
        "kodrix.features.composerUI": {
          "type": "boolean",
          "default": true,
          "description": "启用 Composer 风格多文件 UI：会话侧栏、检查点、Diff 审阅"
        },
        "kodrix.features.codebaseIndex": {
          "type": "boolean",
          "default": true,
          "description": "启用 @Codebase 语义索引（Copilot workspace index）"
        },
        "kodrix.features.codebaseIndexAutoBuild": {
          "type": "boolean",
          "default": true,
          "description": "打开工作区后自动构建代码库语义索引"
        },
        "kodrix.features.agentsWindow": {
          "type": "boolean",
          "default": true,
          "description": "启用 Agents 窗口：多 Agent 并行、Local / CLI / Cloud 会话"
        },
        "kodrix.features.agentFirstLayout": {
          "type": "boolean",
          "default": true,
          "description": "Cursor 3.0：首次打开工作区时最大化 Chat 侧栏并显示 Agent 会话列表"
        },
        "kodrix.features.agentHostPriority": {
          "type": "boolean",
          "default": true,
          "description": "Cursor 3.0：Agents 窗口优先使用 Agent Host（Copilot CLI）"
        },
        "kodrix.features.handoffTip": {
          "type": "boolean",
          "default": true,
          "description": "Cursor 3.0：在 Chat 输入框上方显示「在 Agents 窗口中继续」提示"
        },
        "kodrix.providerWorkbench.panel": {
          "type": "null",
          "default": null,
          "renderer": "kodrix.providerSettings",
          "markdownDescription": "在设置页内嵌 AI 供应商管理界面。也可使用命令 **Kodrix: AI 供应商管理** 打开独立面板。"
        }
      }
    },
    "keybindings": [
      {
        "command": "workbench.action.chat.open",
        "key": "ctrl+l",
        "mac": "cmd+l",
        "when": "!terminalFocus"
      },
      {
        "command": "workbench.action.chat.open",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "args": { "mode": "agent" },
        "when": "config.chat.agent.enabled && !terminalFocus"
      },
      {
        "command": "kodrix.openInlineEdit",
        "key": "ctrl+k",
        "mac": "cmd+k",
        "when": "editorTextFocus && !editorReadonly"
      },
      {
        "command": "kodrix.addSelectionToChat",
        "key": "ctrl+shift+l",
        "mac": "cmd+shift+l",
        "when": "editorTextFocus && editorHasSelection"
      },
      {
        "command": "kodrix.openWorkspaceInAgentsWindow",
        "key": "ctrl+shift+alt+a",
        "mac": "cmd+shift+alt+a",
        "when": "config.chat.agent.enabled && !isSessionsWindow && workspaceFolderCount > 0"
      },
      {
        "command": "kodrix.openAgentsWindow",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a",
        "when": "config.chat.agent.enabled && !isSessionsWindow"
      }
    ]
  },
  "scripts": {
    "compile": "gulp compile-extension:kodrix-local",
    "watch": "gulp watch-extension:kodrix-local"
  },
  "devDependencies": {
    "@types/node": "24.x"
  }
}
