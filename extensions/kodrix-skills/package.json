{
  "name": "kodrix-skills",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "1.1.0",
  "publisher": "kodrix",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:kodrix.skillsMarketplace",
    "onStartupFinished"
  ],
  "main": "./out/extension",
  "contributes": {
    "localizations": [
      {
        "languageId": "zh-cn",
        "languageName": "Chinese (Simplified)",
        "localizedLanguageName": "简体中文",
        "translations": [
          {
            "id": "kodrix.kodrix-skills",
            "path": "package.nls.zh-cn.json"
          }
        ]
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "kodrix-skills",
          "title": "%viewContainer.skillMarket.title%",
          "icon": "$(sparkle)"
        }
      ]
    },
    "views": {
      "kodrix-skills": [
        {
          "type": "webview",
          "id": "kodrix.skillsMarketplace",
          "name": "%view.skillMarket.name%",
          "icon": "$(sparkle)"
        }
      ]
    },
    "commands": [
      {
        "command": "kodrix.skills.refresh",
        "title": "%command.refresh.title%",
        "icon": "$(refresh)",
        "category": "Kodrix"
      },
      {
        "command": "kodrix.skills.install",
        "title": "%command.install.title%",
        "icon": "$(cloud-download)",
        "category": "Kodrix"
      },
      {
        "command": "kodrix.skills.uninstall",
        "title": "%command.uninstall.title%",
        "category": "Kodrix"
      },
      {
        "command": "kodrix.skills.installFromUrl",
        "title": "%command.installFromUrl.title%",
        "category": "Kodrix"
      },
      {
        "command": "kodrix.skills.importCursor",
        "title": "%command.importCursor.title%",
        "category": "Kodrix"
      },
      {
        "command": "kodrix.skills.searchGithub",
        "title": "%command.searchGithub.title%",
        "category": "Kodrix"
      },
      {
        "command": "kodrix.skills.openMarketplace",
        "title": "%command.openMarketplace.title%",
        "category": "Kodrix"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "kodrix.skills.refresh",
          "when": "view == kodrix.skillsMarketplace",
          "group": "navigation"
        },
        {
          "command": "kodrix.skills.installFromUrl",
          "when": "view == kodrix.skillsMarketplace",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Kodrix Skills",
      "properties": {
        "kodrix.skills.installDir": {
          "type": "string",
          "default": "~/.agents/skills",
          "description": "%config.installDir.description%"
        },
        "kodrix.skills.registryUrls": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%config.registryUrls.description%"
        }
      }
    }
  },
  "scripts": {
    "compile": "gulp compile-extension:kodrix-skills",
    "watch": "gulp watch-extension:kodrix-skills",
    "compile:test": "tsc -p tsconfig.test.json",
    "test": "npm run compile:test && node ./out-test/test/runTests.js"
  },
  "devDependencies": {
    "@types/node": "24.x"
  },
  "dependencies": {
    "@parcel/watcher": "^2.5.6"
  }
}
