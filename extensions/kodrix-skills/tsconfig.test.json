{
	"extends": "../tsconfig.base.json",
	"compilerOptions": {
		"rootDir": "./src",
		"outDir": "./out-test",
		"typeRoots": ["./node_modules/@types"],
		"types": ["node"],
		"noUnusedLocals": false,
		"noUnusedParameters": false
	},
	"include": [
		"src/**/*",
		"../../src/vscode-dts/vscode.d.ts"
	],
	"exclude": [
		"out",
		"out-test",
		"node_modules"
	]
}
