		"keybindings": [
			{
				"command": "kodrix.hub.open",
				"key": "ctrl+shift+h",
				"mac": "cmd+shift+h",
				"when": "config.kodrix.hub.enableKeybinding"
			},
			{
				"command": "kodrix.spec.openWorkbench",
				"key": "ctrl+shift+alt+k",
				"when": "config.kodrix.features.spec"
			},
			{
				"command": "kodrix.router.route",
				"key": "ctrl+shift+alt+r",
				"when": "config.kodrix.features.agentRouter"
			},
			{
				"command": "kodrix.learn.capture",
				"key": "ctrl+shift+alt+m",
				"when": "config.kodrix.features.learning"
			},
			{
				"command": "kodrix.vibe.start",
				"key": "ctrl+shift+v",
				"when": "config.kodrix.features.vibeCoding"
			},
			{
				"command": "kodrix.idea.start",
				"key": "ctrl+shift+i",
				"mac": "cmd+shift+i",
				"when": "config.kodrix.features.ideaFlow"
			},
			{
				"command": "kodrix.idea.open",
				"key": "ctrl+shift+alt+i",
				"mac": "cmd+shift+alt+i",
				"when": "config.kodrix.features.ideaFlow"
			},
			{
				"command": "kodrix.codebase.search",
				"key": "ctrl+shift+alt+f",
				"when": "config.kodrix.features.codebaseIntelligence"
			},
			{
				"command": "kodrix.terminal.aiPrompt",
				"key": "ctrl+k",
				"mac": "cmd+k",
				"when": "terminalFocus && config.kodrix.features.terminalAI"
			},
			{
				"command": "kodrix.terminal.aiRun",
				"key": "ctrl+enter",
				"mac": "cmd+enter",
				"when": "kodrix.terminalAI.pending && config.kodrix.features.terminalAI"
			}
		],
		"menus": {
			"view/title": [
				{
					"command": "kodrix.kanban.addTask",
					"when": "view == kodrix.agentKanban",
					"group": "navigation"
				}
			],
			"view/item/context": [
				{
					"command": "kodrix.kanban.moveTask",
					"when": "view == kodrix.agentKanban",
					"group": "inline"
				},
				{
					"command": "kodrix.kanban.openSession",
					"when": "view == kodrix.agentKanban",
					"group": "inline"
				},
				{
					"command": "kodrix.kanban.deleteTask",
					"when": "view == kodrix.agentKanban",
					"group": "inline"
				}
			]
		},
		"configuration": {
			"title": "Kodrix Agent OS",
			"properties": {
				"kodrix.settings": {
					"type": "null",
					"renderer": "kodrix.settings",
					"markdownDescription": "**Kodrix Settings** — 集中管理 Kodrix 全部配置：代码库索引与文档 · AI 供应商 · FIM 补全 · Embedding · 功能开关"
				},
				"kodrix.features.wiki": {
					"type": "boolean",
					"default": true,
					"description": "启用 Repo Wiki 自动生成（Qoder 风格）"
				},
				"kodrix.features.wikiAutoBuild": {
					"type": "boolean",
					"default": true,
					"description": "打开工作区时自动生成 Repo Wiki"
				},
				"kodrix.features.spec": {
					"type": "boolean",
					"default": true,
					"description": "启用 Spec 驱动工作流（Kiro 风格）"
				},
				"kodrix.features.memory": {
					"type": "boolean",
					"default": true,
					"description": "启用跨会话 Memory（Windsurf 风格）"
				},
				"kodrix.features.kanban": {
					"type": "boolean",
					"default": true,
					"description": "启用 Agent Kanban 看板（Devin/Qoder Quest 风格）"
				},
				"kodrix.features.agentRouter": {
					"type": "boolean",
					"default": true,
					"description": "启用统一 Agent OS 智能路由"
				},
				"kodrix.features.arena": {
					"type": "boolean",
					"default": true,
					"description": "启用 Arena 双模型对比（Windsurf 风格）"
				},
				"kodrix.features.hooks": {
					"type": "boolean",
					"default": true,
					"description": "启用 Hooks 预置包（Kiro 风格）"
				},
				"kodrix.features.acp": {
					"type": "boolean",
					"default": true,
					"description": "启用 ACP 外部 Agent 接入（Devin Desktop 风格）"
				},
				"kodrix.features.propertyTests": {
					"type": "boolean",
					"default": true,
					"description": "启用属性测试生成（Kiro 风格）"
				},
				"kodrix.features.learning": {
					"type": "boolean",
					"default": true,
					"description": "启用 Learning Engine（越用越聪明 — 跨会话知识沉淀）"
				},
				"kodrix.features.contextInjection": {
					"type": "boolean",
					"default": true,
					"description": "自动将 Wiki + Memory + Learning 注入 Agent Instructions 与 Chat 上下文"
				},
				"kodrix.features.sessionLearning": {
					"type": "boolean",
					"default": true,
					"description": "Agent 会话结束时自动蒸馏项目知识（Stop Hook + LLM）"
				},
				"kodrix.sessionLearning.mode": {
					"type": "string",
					"enum": [
						"auto",
						"prompt",
						"off"
					],
					"default": "prompt",
					"description": "会话学习模式：auto 自动沉淀 / prompt 询问确认 / off 关闭"
				},
				"kodrix.sessionLearning.minUserMessages": {
					"type": "number",
					"default": 1,
					"minimum": 1,
					"description": "至少多少条用户消息才触发会话学习（过滤 trivial 会话）"
				},
				"kodrix.sessionLearning.autoInstallHook": {
					"type": "boolean",
					"default": true,
					"description": "首次打开工作区时自动安装 .github/hooks Session Learning Hook"
				},
				"kodrix.arena.modelA": {
					"type": "string",
					"default": "",
					"description": "Arena 对比模型 A（留空则使用当前默认模型）"
				},
				"kodrix.arena.modelB": {
					"type": "string",
					"default": "",
					"description": "Arena 对比模型 B"
				},
				"kodrix.router.lastRoute": {
					"type": "object",
					"default": {},
					"description": "上次智能路由结果（自动记录）"
				},
				"kodrix.kanban.showCompleted": {
					"type": "boolean",
					"default": true,
					"description": "在看板中显示已完成的任务"
				},
				"kodrix.experience.autoBootstrap": {
					"type": "boolean",
					"default": true,
					"description": "打开工作区时自动预热 Agent 上下文（Wiki · Memory · Learning · Hooks）"
				},
				"kodrix.experience.showBootstrapTip": {
					"type": "boolean",
					"default": true,
					"description": "首次打开工作区时显示 Hub / 智能路由引导提示"
				},
				"kodrix.features.contextIntelligence": {
					"type": "boolean",
					"default": true,
					"description": "启用 Context Intelligence（Wiki + Memory + Learning 自动注入 Chat）"
				},
				"kodrix.features.semanticMemory": {
					"type": "boolean",
					"default": true,
					"description": "启用语义记忆索引（TF-IDF 向量检索，零外部依赖）"
				},
				"kodrix.features.proactiveContext": {
					"type": "boolean",
					"default": true,
					"description": "打开文件时主动提示相关 Learning / Memory（状态栏 💡 指示）"
				},
				"kodrix.router.autoExecute": {
					"type": "boolean",
					"default": true,
					"description": "智能路由高置信度时自动执行（无需二次确认）"
				},
				"kodrix.features.agentCrew": {
					"type": "boolean",
					"default": true,
					"description": "启用 Agent Crew 多智能体协作编排（Devin / Cursor 3.0 风格）"
				},
				"kodrix.crew.maxParallel": {
					"type": "number",
					"default": 3,
					"minimum": 1,
					"maximum": 10,
					"description": "Crew 并行执行的最大并发任务数（对标 Cursor Subagent 并行派生，默认 3 路）"
				},
				"kodrix.crew.timeoutMs": {
					"type": "number",
					"default": 180000,
					"minimum": 10000,
					"description": "Crew 单任务自动执行超时（毫秒）"
				},
				"kodrix.features.vibeCoding": {
					"type": "boolean",
					"default": true,
					"description": "启用 Vibe Coding（一句描述自动构建项目）"
				},
				"kodrix.features.ideaFlow": {
					"type": "boolean",
					"default": true,
					"description": "启用 Idea Flow — 想法到产品的全自动流水线。从模糊想法到完整可运行应用，AI 负责分析→规划→构建→预览全部环节"
				},
				"kodrix.hub.enableKeybinding": {
					"type": "boolean",
					"default": true,
					"description": "启用 Ctrl+Shift+H 打开 Kodrix Hub（关闭后恢复 VS Code 全局替换快捷键）"
				},
				"kodrix.features.codebaseIntelligence": {
					"type": "boolean",
					"default": true,
					"description": "启用 Codebase Intelligence — 全工程语义索引（AST 级符号/依赖/调用图分析）"
				},
				"kodrix.features.predictiveCompletion": {
					"type": "boolean",
					"default": true,
					"description": "启用上下文预测补全 — 基于全工程索引的「下一步编辑」预测"
				},
				"kodrix.features.codebaseQuery": {
					"type": "boolean",
					"default": true,
					"description": "启用自然语言代码问答 — @codebase 查询定义/引用/架构"
				},
				"kodrix.codebase.autoIndexNewFolders": {
					"type": "boolean",
					"default": true,
					"description": "索引新文件夹：自动索引包含少于 50,000 个文件的文件夹（对标 Cursor 代码库索引）"
				},
				"kodrix.codebase.ignoreCursorignore": {
					"type": "boolean",
					"default": true,
					"description": "忽略 .cursorignore 中的文件：除 .gitignore 外，还要从索引中排除的文件（对标 Cursor）"
				},
				"kodrix.codebase.grepIndex": {
					"type": "boolean",
					"default": true,
					"description": "为即时 Grep 索引仓库（测试版 BETA）：自动索引仓库以加速 Grep 搜索，所有数据均存储在本地（对标 Cursor）"
				},
				"kodrix.features.terminalAI": {
					"type": "boolean",
					"default": true,
					"description": "启用终端 AI prompt 条 — Cmd+K 自然语言生成命令，Cmd+Enter 运行（对标 Cursor）"
				},
				"kodrix.checkpoint.autoCapture": {
					"type": "boolean",
					"default": true,
					"description": "文件保存时自动捕获版本（滚动保留，供回滚参考）"
				},
				"kodrix.checkpoint.maxEntries": {
					"type": "number",
					"default": 100,
					"minimum": 10,
					"maximum": 1000,
					"description": "自动捕获队列最大条目数（超过后删除最旧）"
				},
				"kodrix.idea.autoExecute": {
					"type": "boolean",
					"default": true,
					"description": "Idea Flow 构建阶段端到端自动执行（构建前自动创建检查点，Crew 自动执行全部任务）；关闭后回到手动 Agent 逐任务模式"
				},
				"kodrix.modelRouter.enabled": {
					"type": "boolean",
					"default": true,
					"description": "启用模型 Auto 路由 — 按任务类型（smart/balanced/fast）自动选择模型（对标 Cursor 多模型路由）"
				},
				"kodrix.tabCompletion.enabled": {
					"type": "boolean",
					"default": false,
					"description": "启用 Kodrix Tab 补全（专用 fast 模型通道，对标 Cursor Tab）。默认关闭以避免与上游 Copilot 内联补全冲突"
				},
				"kodrix.agentLoop.maxIterations": {
					"type": "number",
					"default": 20,
					"description": "Agent 推理循环最大迭代轮数（防失控）"
				},
				"kodrix.agentLoop.timeoutMs": {
					"type": "number",
					"default": 600000,
					"description": "Agent 推理循环总超时（毫秒）"
				},
				"kodrix.agentLoop.allowCommands": {
					"type": "boolean",
					"default": true,
					"description": "允许 Agent 推理循环执行终端命令（run_command 工具）"
				},
				"kodrix.tabCompletion.mode": {
					"type": "string",
					"enum": [
						"fim",
						"fast"
					],
					"default": "fim",
					"markdownDescription": "Tab 补全模式：**fim**=专用 FIM 补全通道（默认 DeepSeek FIM，需填 API Key）；**fast**=通用模型通道（无需 Key）。"
				},
				"kodrix.tabCompletion.fimProvider": {
					"type": "string",
					"enum": [
						"deepseek",
						"custom"
					],
					"default": "deepseek",
					"markdownDescription": "FIM 提供方：**deepseek**=DeepSeek FIM（默认端点）；**custom**=自定义 FIM 接口（OpenAI 兼容 completions 格式）。"
				},
				"kodrix.tabCompletion.fimEndpoint": {
					"type": "string",
					"default": "https://api.deepseek.com/beta/fim/completions",
					"markdownDescription": "FIM 端点（custom 提供方时填写自定义 URL）。"
				},
				"kodrix.tabCompletion.fimApiKey": {
					"type": "string",
					"default": "",
					"markdownDescription": "FIM API Key（DeepSeek Key 或自定义 Key）。"
				},
				"kodrix.tabCompletion.fimModel": {
					"type": "string",
					"default": "deepseek-chat",
					"markdownDescription": "FIM 模型名（DeepSeek 默认 deepseek-chat）。"
				},
				"kodrix.semanticEmbedding.enabled": {
					"type": "boolean",
					"default": false,
					"markdownDescription": "启用真向量语义检索（Embedding）。需同时填写 apiKey。"
				},
				"kodrix.semanticEmbedding.apiKey": {
					"type": "string",
					"default": "",
					"markdownDescription": "智谱（BigModel）API Key（https://open.bigmodel.cn）。保存后自动启用。"
				},
				"kodrix.semanticEmbedding.endpoint": {
					"type": "string",
					"default": "https://open.bigmodel.cn/api/paas/v4/embeddings",
					"markdownDescription": "Embedding 端点（自定义时修改）。"
				},
				"kodrix.semanticEmbedding.model": {
					"type": "string",
					"default": "embedding-3",
					"markdownDescription": "Embedding 模型（默认 embedding-3）。"
				},
				"kodrix.agentLoop.checkpoint": {
					"type": "boolean",
					"default": true,
					"description": "Agent 运行前自动创建检查点，可回滚 Agent 造成的全部改动"
				}
			}
		}
	},
	"scripts": {
		"compile": "gulp compile-extension:kodrix-agent-os",
		"watch": "gulp watch-extension:kodrix-agent-os"
	},
	"devDependencies": {
		"@types/node": "24.x"
	}
}
