		"keybindings": [
			{
				"command": "kodrix.hub.open",
				"key": "ctrl+shift+h",
				"mac": "cmd+shift+h",
				"when": "config.kodrix.hub.enableKeybinding"
			},
			{
				"command": "kodrix.spec.openWorkbench",
				"key": "ctrl+shift+alt+k",
				"when": "config.kodrix.features.spec"
			},
			{
				"command": "kodrix.router.route",
				"key": "ctrl+shift+alt+r",
				"when": "config.kodrix.features.agentRouter"
			},
			{
				"command": "kodrix.learn.capture",
				"key": "ctrl+shift+alt+m",
				"when": "config.kodrix.features.learning"
			},
			{
				"command": "kodrix.vibe.start",
				"key": "ctrl+shift+v",
				"when": "config.kodrix.features.vibeCoding"
			},
			{
				"command": "kodrix.idea.start",
				"key": "ctrl+shift+i",
				"mac": "cmd+shift+i",
				"when": "config.kodrix.features.ideaFlow"
			},
			{
				"command": "kodrix.idea.open",
				"key": "ctrl+shift+alt+i",
				"mac": "cmd+shift+alt+i",
				"when": "config.kodrix.features.ideaFlow"
			},
			{
				"command": "kodrix.codebase.search",
				"key": "ctrl+shift+alt+f",
				"when": "config.kodrix.features.codebaseIntelligence"
			},
			{
				"command": "kodrix.terminal.aiPrompt",
				"key": "ctrl+k",
				"mac": "cmd+k",
				"when": "terminalFocus && config.kodrix.features.terminalAI"
			},
			{
				"command": "kodrix.terminal.aiRun",
				"key": "ctrl+enter",
				"mac": "cmd+enter",
				"when": "kodrix.terminalAI.pending && config.kodrix.features.terminalAI"
			},
			{
				"command": "kodrix.router.naturalPalette",
				"key": "ctrl+shift+l",
				"when": "!editorTextFocus"
			}
		],
		"menus": {
			"view/title": [
				{
					"command": "kodrix.kanban.addTask",
					"when": "view == kodrix.agentKanban",
					"group": "navigation"
				},
				{
					"command": "kodrix.checkpoint.refreshTimeline",
					"when": "view == kodrix.checkpoints",
					"group": "navigation"
				},
				{
					"command": "kodrix.checkpoint.diffGallery",
					"when": "view == kodrix.checkpoints",
					"group": "navigation"
				}
			],
			"view/item/context": [
				{
					"command": "kodrix.kanban.moveTask",
					"when": "view == kodrix.agentKanban",
					"group": "inline"
				},
				{
					"command": "kodrix.kanban.openSession",
					"when": "view == kodrix.agentKanban",
					"group": "inline"
				},
				{
					"command": "kodrix.kanban.deleteTask",
					"when": "view == kodrix.agentKanban",
					"group": "inline"
				},
				{
					"command": "kodrix.checkpoint.restore",
					"when": "view == kodrix.checkpoints && viewItem == checkpoint",
					"group": "inline"
				}
			]
		},
