{
	"name": "kodrix-agent-os",
	"displayName": "%displayName%",
	"description": "%description%",
	"version": "1.0.0",
	"publisher": "kodrix",
	"license": "MIT",
	"engines": {
		"vscode": "^1.128.0"
	},
	"categories": [
		"Other",
		"Machine Learning"
	],
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./out/extension",
	"enabledApiProposals": [
		"chatContextProvider",
		"settingsEditorRenderer"
	],
	"contributes": {
		"settingsEditorRenderers": [
			{
				"viewType": "kodrix.settings"
			}
		],
		"chatParticipants": [
			{
				"id": "kodrix.codebase",
				"name": "codebase",
				"fullName": "%chatParticipant.codebase.fullName%",
				"description": "%chatParticipant.codebase.description%",
				"isSticky": true,
				"commands": [
					{
						"name": "def",
						"description": "%chatParticipant.codebase.command.def.description%"
					},
					{
						"name": "refs",
						"description": "%chatParticipant.codebase.command.refs.description%"
					},
					{
						"name": "deps",
						"description": "%chatParticipant.codebase.command.deps.description%"
					},
					{
						"name": "dependents",
						"description": "%chatParticipant.codebase.command.dependents.description%"
					}
				]
			}
		],
		"localizations": [
			{
				"languageId": "zh-cn",
				"languageName": "Chinese (Simplified)",
				"localizedLanguageName": "简体中文",
				"translations": [
					{
						"id": "kodrix.kodrix-agent-os",
						"path": "package.nls.zh-cn.json"
					}
				]
			}
		],
		"views": {
			"explorer": [
