{
	"name": "kodrix-agent-os",
	"displayName": "Kodrix Agent OS",
	"description": "让软件开发回归想法本身 — Idea Flow 全自动流水线 · Repo Wiki · Spec 驱动 · Memory · Kanban · Agent 路由 · Arena · Hooks · ACP · 属性测试 · 越用越聪明",
	"version": "1.0.0",
	"publisher": "kodrix",
	"license": "MIT",
	"engines": {
		"vscode": "^1.90.0"
	},
	"categories": [
		"Other",
		"Machine Learning"
	],
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./out/extension",
	"enabledApiProposals": [
		"chatContextProvider",
		"settingsEditorRenderer"
	],
	"contributes": {
		"settingsEditorRenderers": [
			{
				"viewType": "kodrix.settings"
			}
		],
		"chatParticipants": [
			{
				"id": "kodrix.codebase",
				"name": "codebase",
				"fullName": "Codebase Intelligence",
				"description": "自然语言代码问答：查询符号定义 / 引用 / 依赖 / 架构（本地语义索引，零外部依赖）",
				"isSticky": true,
				"commands": [
					{
						"name": "def",
						"description": "查找符号定义位置"
					},
					{
						"name": "refs",
						"description": "查找符号的所有引用"
					},
					{
						"name": "deps",
						"description": "查看文件的依赖关系"
					},
					{
						"name": "dependents",
						"description": "查看哪些文件依赖该文件"
					}
				]
			}
		],
		"localizations": [
			{
				"languageId": "zh-cn",
				"languageName": "Chinese (Simplified)",
				"localizedLanguageName": "简体中文",
				"translations": [
					{
						"id": "kodrix.kodrix-agent-os",
						"path": "package.nls.zh-cn.json"
					}
				]
			}
		],
