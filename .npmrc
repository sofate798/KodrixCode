# ── Node-gyp / Electron header configs ──────────────────────────────
# These keys are consumed by build/npm/preinstall.ts → node-gyp to
# download Electron headers for native module compilation.
# npm 11 emits warnings for them ("Unknown project config") because
# node-gyp is no longer bundled; the warnings are harmless.
# preinstall.ts enforces npm < 12, which would require a format update.
disturl="https://electronjs.org/headers"
target="42.5.0"
ms_build_id="14500164"
runtime="electron"
# ── npm behaviour ───────────────────────────────────────────────────
ignore-scripts=false
build_from_source="true"
legacy-peer-deps="true"
timeout=180000
